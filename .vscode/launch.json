{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Attach to PostgreSQL backend (pick process)",
            "type": "cppdbg",
            "request": "attach",
            "program": "${workspaceFolder}/src/backend/postgres",
            "processId": "${command:pickProcess}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Load PostgreSQL GDB helpers",
                    "text": "source ${workspaceFolder}/.gdbinit",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Attach to PostgreSQL backend (enter PID)",
            "type": "cppdbg",
            "request": "attach",
            "program": "${workspaceFolder}/src/backend/postgres",
            "processId": "${input:backendPid}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Load PostgreSQL GDB helpers",
                    "text": "source ${workspaceFolder}/.gdbinit",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Attach to logical replication sync worker",
            "type": "cppdbg",
            "request": "attach",
            "program": "${workspaceFolder}/src/backend/postgres",
            "processId": "${input:syncWorkerPid}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Load PostgreSQL GDB helpers",
                    "text": "source ${workspaceFolder}/.gdbinit",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Attach to postmaster",
            "type": "cppdbg",
            "request": "attach",
            "program": "${workspaceFolder}/src/backend/postgres",
            "processId": "${input:postmasterPid}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Load PostgreSQL GDB helpers",
                    "text": "source ${workspaceFolder}/.gdbinit",
                    "ignoreFailures": true
                },
                {
                    "description": "Follow child on fork",
                    "text": "set follow-fork-mode child",
                    "ignoreFailures": false
                },
                {
                    "description": "Detach from parent on fork",
                    "text": "set detach-on-fork on",
                    "ignoreFailures": false
                }
            ]
        }
    ],
    "inputs": [
        {
            "id": "backendPid",
            "type": "promptString",
            "description": "PostgreSQL backend PID  (psql: SELECT pg_backend_pid();)"
        },
        {
            "id": "syncWorkerPid",
            "type": "promptString",
            "description": "sync worker PID  (psql: SELECT pid,relid FROM pg_stat_subscription WHERE worker_type='table synchronization';)"
        },
        {
            "id": "postmasterPid",
            "type": "promptString",
            "description": "postmaster PID  (pg_ctl status / head -1 $PGDATA/postmaster.pid)"
        }
    ]
}
