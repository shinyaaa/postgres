CREATE VIEW rlsdbg.v AS SELECT 1 AS x;
SELECT * FROM pg_rls_status('rlsdbg.v');
ERROR:  "rlsdbg.v" is not a table
DETAIL:  Row-level security policies can only be defined on ordinary and partitioned tables.
