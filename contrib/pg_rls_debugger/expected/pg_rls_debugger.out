--
-- Tests for pg_rls_debugger
--
CREATE EXTENSION pg_rls_debugger;
CREATE ROLE regress_rlsdbg_alice;
CREATE ROLE regress_rlsdbg_bob;
CREATE ROLE regress_rlsdbg_admin BYPASSRLS;
CREATE SCHEMA rlsdbg;
GRANT USAGE ON SCHEMA rlsdbg
    TO regress_rlsdbg_alice, regress_rlsdbg_bob, regress_rlsdbg_admin;
CREATE TABLE rlsdbg.docs (
    id int PRIMARY KEY,
    owner name,
    tenant int,
    is_public bool,
    body text
);
INSERT INTO rlsdbg.docs VALUES
    (1, 'regress_rlsdbg_alice', 1, false, 'alice secret'),
    (2, 'regress_rlsdbg_bob',   1, false, 'bob secret'),
    (3, 'regress_rlsdbg_alice', 2, false, 'alice, wrong tenant'),
    (4, 'nobody',               1, true,  'public doc');
GRANT SELECT, INSERT, UPDATE, DELETE ON rlsdbg.docs
    TO regress_rlsdbg_alice, regress_rlsdbg_bob, regress_rlsdbg_admin;
-- Status before RLS is enabled
SELECT rls_enabled, rls_applied, policy_count, summary
  FROM pg_rls_status('rlsdbg.docs', 'regress_rlsdbg_alice');
 rls_enabled | rls_applied | policy_count |                                               summary                                               
-------------+-------------+--------------+-----------------------------------------------------------------------------------------------------
 f           | f           |            0 | RLS is not enabled on rlsdbg.docs; role regress_rlsdbg_alice is limited only by ordinary privileges
(1 row)

ALTER TABLE rlsdbg.docs ENABLE ROW LEVEL SECURITY;
CREATE POLICY p_owner ON rlsdbg.docs
    USING (owner = current_user);
CREATE POLICY p_public_read ON rlsdbg.docs FOR SELECT
    USING (is_public);
CREATE POLICY p_insert_self ON rlsdbg.docs FOR INSERT
    WITH CHECK (owner = current_user);
CREATE POLICY p_admin_all ON rlsdbg.docs TO regress_rlsdbg_admin
    USING (true);
CREATE POLICY r_tenant ON rlsdbg.docs AS RESTRICTIVE
    USING (tenant = 1);
-- Status: plain role, BYPASSRLS role, and superuser (never applied)
SELECT rls_enabled, rls_forced, rls_applied, policy_count, policies_for_role, summary
  FROM pg_rls_status('rlsdbg.docs', 'regress_rlsdbg_alice');
 rls_enabled | rls_forced | rls_applied | policy_count | policies_for_role |                                          summary                                           
-------------+------------+-------------+--------------+-------------------+--------------------------------------------------------------------------------------------
 t           | f          | t           |            5 |                 4 | RLS is applied to role regress_rlsdbg_alice on rlsdbg.docs: 4 of 5 policies match the role
(1 row)

SELECT rls_applied, summary
  FROM pg_rls_status('rlsdbg.docs', 'regress_rlsdbg_admin');
 rls_applied |                                       summary                                       
-------------+-------------------------------------------------------------------------------------
 f           | RLS is enabled on rlsdbg.docs but role regress_rlsdbg_admin bypasses it (BYPASSRLS)
(1 row)

SELECT rls_applied FROM pg_rls_status('rlsdbg.docs');
 rls_applied 
-------------
 f
(1 row)

-- Policy listing
SELECT * FROM pg_rls_policies('rlsdbg.docs', 'regress_rlsdbg_bob');
  policy_name  | policy_kind | policy_cmd |      policy_roles      | applies_to_role |       using_expr       |       check_expr       
---------------+-------------+------------+------------------------+-----------------+------------------------+------------------------
 p_admin_all   | PERMISSIVE  | ALL        | {regress_rlsdbg_admin} | f               | true                   | 
 p_insert_self | PERMISSIVE  | INSERT     | {public}               | t               |                        | (owner = CURRENT_USER)
 p_owner       | PERMISSIVE  | ALL        | {public}               | t               | (owner = CURRENT_USER) | 
 p_public_read | PERMISSIVE  | SELECT     | {public}               | t               | is_public              | 
 r_tenant      | RESTRICTIVE | ALL        | {public}               | t               | (tenant = 1)           | 
(5 rows)

-- Per-row, per-policy evaluation.
-- Row 1 (alice's, tenant 1) as alice: p_owner passes, r_tenant passes.
SELECT c.policy_name, c.policy_kind, c.applies_to_role, c.applies_to_cmd,
       c.using_result
  FROM rlsdbg.docs d,
       LATERAL pg_rls_check_row('rlsdbg.docs', d.ctid, 'regress_rlsdbg_alice') c
 WHERE d.id = 1;
  policy_name  | policy_kind | applies_to_role | applies_to_cmd | using_result 
---------------+-------------+-----------------+----------------+--------------
 p_admin_all   | PERMISSIVE  | f               | t              | 
 p_insert_self | PERMISSIVE  | t               | f              | 
 p_owner       | PERMISSIVE  | t               | t              | pass
 p_public_read | PERMISSIVE  | t               | t              | fail
 r_tenant      | RESTRICTIVE | t               | t              | pass
(5 rows)

-- Row 3 (alice's, tenant 2) as alice: restrictive r_tenant fails.
SELECT c.policy_name, c.policy_kind, c.using_result
  FROM rlsdbg.docs d,
       LATERAL pg_rls_check_row('rlsdbg.docs', d.ctid, 'regress_rlsdbg_alice') c
 WHERE d.id = 3;
  policy_name  | policy_kind | using_result 
---------------+-------------+--------------
 p_admin_all   | PERMISSIVE  | 
 p_insert_self | PERMISSIVE  | 
 p_owner       | PERMISSIVE  | pass
 p_public_read | PERMISSIVE  | fail
 r_tenant      | RESTRICTIVE | fail
(5 rows)

-- UPDATE evaluates USING and WITH CHECK
SELECT c.policy_name, c.applies_to_cmd, c.using_result, c.check_result
  FROM rlsdbg.docs d,
       LATERAL pg_rls_check_row('rlsdbg.docs', d.ctid, 'regress_rlsdbg_bob', 'update') c
 WHERE d.id = 2;
  policy_name  | applies_to_cmd | using_result | check_result 
---------------+----------------+--------------+--------------
 p_admin_all   | t              |              | 
 p_insert_self | f              |              | 
 p_owner       | t              | pass         | pass
 p_public_read | f              |              | 
 r_tenant      | t              | pass         | pass
(5 rows)

-- Human-readable reports
SELECT pg_rls_why('rlsdbg.docs', d.ctid, 'regress_rlsdbg_alice', 'select')
  FROM rlsdbg.docs d WHERE d.id = 1;
                                              pg_rls_why                                              
------------------------------------------------------------------------------------------------------
 RLS debug report for table rlsdbg.docs                                                              +
   row (0,1), role regress_rlsdbg_alice, command SELECT                                              +
   status: RLS is applied to role regress_rlsdbg_alice on rlsdbg.docs: 4 of 5 policies match the role+
                                                                                                     +
   PERMISSIVE policy p_admin_all (FOR ALL): skipped, role does not match                             +
   PERMISSIVE policy p_insert_self (FOR INSERT): skipped, command does not match                     +
   PERMISSIVE policy p_owner (FOR ALL):                                                              +
     USING ((owner = CURRENT_USER)) => pass                                                          +
   PERMISSIVE policy p_public_read (FOR SELECT):                                                     +
     USING (is_public) => fail                                                                       +
   RESTRICTIVE policy r_tenant (FOR ALL):                                                            +
     USING ((tenant = 1)) => pass                                                                    +
                                                                                                     +
 VERDICT: role regress_rlsdbg_alice CAN SELECT this row (allowed by p_owner).
(1 row)

SELECT pg_rls_why('rlsdbg.docs', d.ctid, 'regress_rlsdbg_alice', 'select')
  FROM rlsdbg.docs d WHERE d.id = 2;
                                              pg_rls_why                                              
------------------------------------------------------------------------------------------------------
 RLS debug report for table rlsdbg.docs                                                              +
   row (0,2), role regress_rlsdbg_alice, command SELECT                                              +
   status: RLS is applied to role regress_rlsdbg_alice on rlsdbg.docs: 4 of 5 policies match the role+
                                                                                                     +
   PERMISSIVE policy p_admin_all (FOR ALL): skipped, role does not match                             +
   PERMISSIVE policy p_insert_self (FOR INSERT): skipped, command does not match                     +
   PERMISSIVE policy p_owner (FOR ALL):                                                              +
     USING ((owner = CURRENT_USER)) => fail                                                          +
   PERMISSIVE policy p_public_read (FOR SELECT):                                                     +
     USING (is_public) => fail                                                                       +
   RESTRICTIVE policy r_tenant (FOR ALL):                                                            +
     USING ((tenant = 1)) => pass                                                                    +
                                                                                                     +
 VERDICT: role regress_rlsdbg_alice CANNOT SELECT this row.                                          +
 Reason: no permissive policy passed: p_owner => fail, p_public_read => fail
(1 row)

SELECT pg_rls_why('rlsdbg.docs', d.ctid, 'regress_rlsdbg_alice', 'select')
  FROM rlsdbg.docs d WHERE d.id = 3;
                                              pg_rls_why                                              
------------------------------------------------------------------------------------------------------
 RLS debug report for table rlsdbg.docs                                                              +
   row (0,3), role regress_rlsdbg_alice, command SELECT                                              +
   status: RLS is applied to role regress_rlsdbg_alice on rlsdbg.docs: 4 of 5 policies match the role+
                                                                                                     +
   PERMISSIVE policy p_admin_all (FOR ALL): skipped, role does not match                             +
   PERMISSIVE policy p_insert_self (FOR INSERT): skipped, command does not match                     +
   PERMISSIVE policy p_owner (FOR ALL):                                                              +
     USING ((owner = CURRENT_USER)) => pass                                                          +
   PERMISSIVE policy p_public_read (FOR SELECT):                                                     +
     USING (is_public) => fail                                                                       +
   RESTRICTIVE policy r_tenant (FOR ALL):                                                            +
     USING ((tenant = 1)) => fail                                                                    +
                                                                                                     +
 VERDICT: role regress_rlsdbg_alice CANNOT SELECT this row.                                          +
 Reason: restrictive policy failed: r_tenant
(1 row)

-- Which rows can bob not see, and why?
SELECT row_data->>'id' AS id, reason
  FROM pg_rls_hidden_rows('rlsdbg.docs', 'regress_rlsdbg_bob')
 ORDER BY (row_data->>'id')::int;
 id |                                                  reason                                                  
----+----------------------------------------------------------------------------------------------------------
 1  | no permissive policy passed: p_owner => fail, p_public_read => fail
 3  | no permissive policy passed: p_owner => fail, p_public_read => fail; restrictive policy failed: r_tenant
(2 rows)

-- Nothing is hidden from a role that bypasses RLS
SELECT count(*) FROM pg_rls_hidden_rows('rlsdbg.docs', 'regress_rlsdbg_admin');
NOTICE:  no rows are hidden: RLS is enabled on rlsdbg.docs but role regress_rlsdbg_admin bypasses it (BYPASSRLS)
 count 
-------
     0
(1 row)

-- UPDATE report warns when WITH CHECK does not pass for the current values
SELECT pg_rls_why('rlsdbg.docs', d.ctid, 'regress_rlsdbg_alice', 'update')
  FROM rlsdbg.docs d WHERE d.id = 3;
                                                                 pg_rls_why                                                                  
---------------------------------------------------------------------------------------------------------------------------------------------
 RLS debug report for table rlsdbg.docs                                                                                                     +
   row (0,3), role regress_rlsdbg_alice, command UPDATE                                                                                     +
   status: RLS is applied to role regress_rlsdbg_alice on rlsdbg.docs: 4 of 5 policies match the role                                       +
                                                                                                                                            +
   PERMISSIVE policy p_admin_all (FOR ALL): skipped, role does not match                                                                    +
   PERMISSIVE policy p_insert_self (FOR INSERT): skipped, command does not match                                                            +
   PERMISSIVE policy p_owner (FOR ALL):                                                                                                     +
     USING ((owner = CURRENT_USER)) => pass                                                                                                 +
     WITH CHECK ((owner = CURRENT_USER)) => pass                                                                                            +
   PERMISSIVE policy p_public_read (FOR SELECT): skipped, command does not match                                                            +
   RESTRICTIVE policy r_tenant (FOR ALL):                                                                                                   +
     USING ((tenant = 1)) => fail                                                                                                           +
     WITH CHECK ((tenant = 1)) => fail                                                                                                      +
                                                                                                                                            +
 VERDICT: role regress_rlsdbg_alice CANNOT UPDATE this row.                                                                                 +
 Reason: restrictive policy failed: r_tenant                                                                                                +
 Note: WITH CHECK did not pass for r_tenant when evaluated against the current row values; an UPDATE keeping these values would be rejected.
(1 row)

-- max_rows / scan_limit notices
SELECT count(*) FROM pg_rls_hidden_rows('rlsdbg.docs', 'regress_rlsdbg_bob', 'select', 1);
NOTICE:  output limited to 1 hidden rows (max_rows); there may be more
 count 
-------
     1
(1 row)

SELECT count(*) FROM pg_rls_hidden_rows('rlsdbg.docs', 'regress_rlsdbg_bob', 'select', 100, 2);
NOTICE:  only the first 2 rows were scanned (scan_limit); there may be more hidden rows
 count 
-------
     1
(1 row)

-- Test a hypothetical INSERT before running it
SELECT policy_name, check_expr, check_result
  FROM pg_rls_check_values('rlsdbg.docs',
                           '{"id": 99, "owner": "regress_rlsdbg_bob", "tenant": 1}',
                           'regress_rlsdbg_bob')
 WHERE applies_to_role AND applies_to_cmd;
  policy_name  |       check_expr       | check_result 
---------------+------------------------+--------------
 p_insert_self | (owner = CURRENT_USER) | pass
 p_owner       | (owner = CURRENT_USER) | pass
 r_tenant      | (tenant = 1)           | pass
(3 rows)

SELECT policy_name, check_result
  FROM pg_rls_check_values('rlsdbg.docs',
                           '{"id": 99, "owner": "somebody_else", "tenant": 1}',
                           'regress_rlsdbg_bob')
 WHERE applies_to_role AND applies_to_cmd;
  policy_name  | check_result 
---------------+--------------
 p_insert_self | fail
 p_owner       | fail
 r_tenant      | pass
(3 rows)

-- Owner and FORCE ROW LEVEL SECURITY
ALTER TABLE rlsdbg.docs OWNER TO regress_rlsdbg_alice;
SELECT rls_applied, summary
  FROM pg_rls_status('rlsdbg.docs', 'regress_rlsdbg_alice');
 rls_applied |                                                      summary                                                       
-------------+--------------------------------------------------------------------------------------------------------------------
 f           | RLS is enabled on rlsdbg.docs but role regress_rlsdbg_alice owns the table and FORCE ROW LEVEL SECURITY is not set
(1 row)

ALTER TABLE rlsdbg.docs FORCE ROW LEVEL SECURITY;
SELECT rls_applied, summary
  FROM pg_rls_status('rlsdbg.docs', 'regress_rlsdbg_alice');
 rls_applied |                                          summary                                           
-------------+--------------------------------------------------------------------------------------------
 t           | RLS is applied to role regress_rlsdbg_alice on rlsdbg.docs: 4 of 5 policies match the role
(1 row)

ALTER TABLE rlsdbg.docs NO FORCE ROW LEVEL SECURITY;
-- Default deny: RLS enabled but no policies
CREATE TABLE rlsdbg.nopol (id int);
INSERT INTO rlsdbg.nopol VALUES (1);
GRANT SELECT ON rlsdbg.nopol TO regress_rlsdbg_bob;
ALTER TABLE rlsdbg.nopol ENABLE ROW LEVEL SECURITY;
SELECT rls_applied, summary
  FROM pg_rls_status('rlsdbg.nopol', 'regress_rlsdbg_bob');
 rls_applied |                                                            summary                                                            
-------------+-------------------------------------------------------------------------------------------------------------------------------
 t           | RLS is applied to role regress_rlsdbg_bob on rlsdbg.nopol: 0 of 0 policies match the role - default deny, ALL rows are hidden
(1 row)

SELECT row_data, reason
  FROM pg_rls_hidden_rows('rlsdbg.nopol', 'regress_rlsdbg_bob');
 row_data  |                                      reason                                       
-----------+-----------------------------------------------------------------------------------
 {"id": 1} | no permissive policy applies to role regress_rlsdbg_bob for SELECT (default deny)
(1 row)

SELECT pg_rls_why('rlsdbg.nopol', n.ctid, 'regress_rlsdbg_bob')
  FROM rlsdbg.nopol n;
                                                               pg_rls_why                                                                
-----------------------------------------------------------------------------------------------------------------------------------------
 RLS debug report for table rlsdbg.nopol                                                                                                +
   row (0,1), role regress_rlsdbg_bob, command SELECT                                                                                   +
   status: RLS is applied to role regress_rlsdbg_bob on rlsdbg.nopol: 0 of 0 policies match the role - default deny, ALL rows are hidden+
                                                                                                                                        +
                                                                                                                                        +
 VERDICT: role regress_rlsdbg_bob CANNOT SELECT this row.                                                                               +
 Reason: no permissive policy applies to role regress_rlsdbg_bob for SELECT (default deny)
(1 row)

-- Unprivileged use: a role may debug itself (rows are fetched with its
-- own privileges, so it can only inspect rows it already sees)
SET SESSION AUTHORIZATION regress_rlsdbg_alice;
SELECT c.policy_name, c.using_result
  FROM rlsdbg.docs d,
       LATERAL pg_rls_check_row('rlsdbg.docs', d.ctid) c
 WHERE d.id = 1;
  policy_name  | using_result 
---------------+--------------
 p_admin_all   | 
 p_insert_self | 
 p_owner       | pass
 p_public_read | fail
 r_tenant      | pass
(5 rows)

-- ... but may not debug as a role it is not a member of
SELECT * FROM pg_rls_check_row('rlsdbg.docs', '(0,1)', 'regress_rlsdbg_bob');
ERROR:  permission denied to debug as role "regress_rlsdbg_bob"
DETAIL:  Policy expressions are evaluated with SET ROLE, which requires membership in the target role.
HINT:  Run this function as a member of the target role or as a superuser.
CONTEXT:  PL/pgSQL function public._rls_debugger_eval(regclass,jsonb,name,text) line 23 at RAISE
SQL statement "SELECT * FROM public._rls_debugger_eval(
        rel,
        public._rls_debugger_fetch_row(rel, row_ctid),
        target_role,
        public._rls_debugger_cmd(command))"
PL/pgSQL function public.pg_rls_check_row(regclass,tid,name,text) line 3 at RETURN QUERY
RESET SESSION AUTHORIZATION;
